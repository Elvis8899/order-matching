LOG_PRETTIFY='true'
LOG_LEVEL='info'

# ----------------------------------------------------------
# Server configuration
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# ----------------------------------------------------------
# Prisma configuration
# ----------------------------------------------------------
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL='postgresql://user:password@postgres:5432/exchange'
# DATABASE_URL='postgresql://user:password@localhost:5432/exchange' #for local
DB_HOST='localhost'
DB_PORT=5432
DB_USERNAME='user'
DB_PASSWORD='password'
DB_NAME='exchange'

# ----------------------------------------------------------
# Auth configuration
# ----------------------------------------------------------
# Required, at least 32 characters. The values below are for local development only.
# Generate real ones with: openssl rand -base64 48
JWT_SECRET_KEY='dev-only-insecure-jwt-secret-change-me-in-production'
JWT_REFRESH_SECRET='dev-only-insecure-jwt-refresh-secret-change-me-in-production'
