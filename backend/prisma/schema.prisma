generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleEnum {
  admin
  client
}

model User {
  id           String       @unique
  username     String       @unique
  // bcrypt hash
  password     String
  role         UserRoleEnum @default(client)
  // Incremented to revoke all refresh tokens issued to the user
  tokenVersion Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders          Order[]
  wallet          Wallet?
  refreshSessions RefreshSession[]
}

// One per login. Refresh tokens are single-use: only the token carrying the
// session's current jti is accepted, and each refresh replaces it
model RefreshSession {
  id         String   @id
  currentJti String
  expiresAt  DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Money is exact: BTC to the satoshi (8 places), USD to 10 places, which
// holds a cent price times a satoshi amount
model Wallet {
  btc Decimal @default(0) @db.Decimal(30, 8)
  usd Decimal @default(0) @db.Decimal(30, 10)

  id   String @unique
  user User   @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderSide {
  buy
  sell
}

enum OrderStatus {
  active
  partial
  complete
  cancelled
}

model Order {
  id     String      @unique
  side   OrderSide
  price  Decimal     @db.Decimal(30, 10) // USD per BTC
  amount Decimal     @db.Decimal(30, 8) // BTC
  filled Decimal     @db.Decimal(30, 8) // BTC filled so far
  status OrderStatus

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, userId], map: "idx_status_userId")
}

model Match {
  id String @unique

  price       Decimal @db.Decimal(30, 10)
  volume      Decimal @db.Decimal(30, 10) // USD
  buyOrderId  String
  sellOrderId String
  buyUserId   String
  sellUserId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt], map: "idx_createdAt")
  @@index([buyUserId], map: "idx_buyUserId")
  @@index([sellUserId], map: "idx_sellUserId")
}
